<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  매거진 producer — 매일 01:00 KST

  하는 일: magazine-producer-run.mjs 를 띄운다.
    ├ magazine-producer-plan.mjs    오늘 무엇을 만들지 선정하고 _runs/{date}/ 에 작업 패키지
    └ magazine-producer-notify.mjs  알릴 것이 있을 때만 Slack (#소란소란-알림)
  하지 않는 일: 원고 작성 · hero 생성 · articles.ts 등록 · 공개 · commit · push.

  🔴 이 plist 는 secret 을 모른다.
     webhook 은 notify 가 ~/.config/soransoran/slack.env 에서 직접 읽는다.
     plist 는 repo 에 커밋되므로 여기에 secret 을 넣으면 git 에 들어간다.

  🔴 정상 실행은 조용하다. 실패·경고만 Slack 으로 간다.
     매일 오는 알림은 곧 읽히지 않는다.
  (원고 제작은 Claude Code 세션이 이어받는다 — docs/operations/2026-08-25-magazine-continuation-runbook.md)

  설치:
    ln -s /Users/yanadoo/Documents/soransoran/launchd/com.soransoran.magazine-producer.plist \
          ~/Library/LaunchAgents/com.soransoran.magazine-producer.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.soransoran.magazine-producer.plist

  🔴 node 경로가 nvm 버전에 묶여 있다.
     nvm 으로 node 를 올리면 이 plist 의 경로 2곳이 죽는다(ProgramArguments · PATH).
     `node -v` 가 아래 버전과 다르면 plist 를 먼저 갱신한다.
     현재 기준: v24.14.0
     시스템 경로(/usr/local/bin · /opt/homebrew/bin · /usr/bin)에는 node 가 없다.

  🔴 ProgramArguments[0] 에 셸(/bin/bash 등)을 쓰지 않는다.
     launchd 의 셸은 kTCCServiceSystemPolicyDocumentsFolder 미승인이라
     ~/Documents/ 에 접근하지 못한다 (Operation not permitted, exit 126).
     node 는 TCC 승인돼 있어 직접 실행한다. 래퍼 스크립트가 필요 없다.

  🔴 KeepAlive 를 넣지 않는다.
     실패 시 launchd 가 재시도하면 폭주한다. producer 자체도 재시도하지 않는다
     (죽은 lock 은 ABORTED 로 기록만 하고 다음 날을 기다린다).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.soransoran.magazine-producer</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yanadoo/.nvm/versions/node/v24.14.0/bin/node</string>
    <string>/Users/yanadoo/Documents/soransoran/scripts/magazine-producer-run.mjs</string>
  </array>

  <!--
    🔴 soransoran-m0 가 아니다. 같은 repo 의 다른 worktree 를 가리키면
       그쪽 articles.ts 로 재고를 계산한다.
       (스크립트가 자기 파일 위치로 repo 를 잡으므로 이 값이 틀려도 방어되지만,
        로그·상대경로가 어긋나므로 정확히 둔다)
  -->
  <key>WorkingDirectory</key>
  <string>/Users/yanadoo/Documents/soransoran</string>

  <!-- 01:00 KST. 시스템 timezone 이 Asia/Seoul 이라 그대로 KST 다 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>1</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- 등록하는 순간 돌지 않는다. 검증은 launchctl kickstart 로 한다 -->
  <key>RunAtLoad</key>
  <false/>

  <!-- repo 밖에 남긴다. repo 안에 두면 .gitignore 를 함께 고쳐야 한다 -->
  <key>StandardOutPath</key>
  <string>/Users/yanadoo/Library/Logs/soransoran/magazine-producer.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yanadoo/Library/Logs/soransoran/magazine-producer.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/yanadoo/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/yanadoo</string>
  </dict>
</dict>
</plist>
