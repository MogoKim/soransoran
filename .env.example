# 소란소란 환경변수
#
# 🔴 우나어(age-doesnt-matter)의 값을 절대 재사용하지 않는다.
#    모든 값은 소란소란 전용으로 신규 발급한다.
# 🔴 실제 값은 .env.local 또는 Vercel 환경변수에만 넣는다. 커밋 금지.

# ── 필수 (첫 배포) ───────────────────────────────
# Supabase 신규 프로젝트 · pooler 6543
DATABASE_URL=
# Supabase 신규 프로젝트 · direct 5432
DIRECT_URL=

# 배포 URL (preview 단계에서는 vercel preview URL)
NEXTAUTH_URL=
# openssl rand -base64 32
NEXTAUTH_SECRET=

# 소란소란 전용 Kakao 앱
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 공개 URL (metadata · sitemap · OG 기준)
NEXT_PUBLIC_APP_URL=

# ── 필수 (보호장치) ──────────────────────────────
# rate limit. 미설정 시 인메모리 fallback 이지만
# 서버리스에서는 인스턴스가 분산되어 사실상 무력화된다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 운영 ────────────────────────────────────────
# /admin/reports 접근 허용 이메일. 쉼표로 구분한다.
# 비워두면 User.isAdmin = true 인 계정만 접근할 수 있다.
SORAN_ADMIN_EMAILS=

# ── 색인 제어 ───────────────────────────────────
# preview 기간에는 비워 둔다(= 전체 disallow).
# production go 판정 후에만 true 로 바꾼다.
SORAN_ALLOW_INDEXING=

# ── D+1 (검색엔진 등록 시) ───────────────────────
NEXT_PUBLIC_GSC_VERIFICATION=
NAVER_SITE_VERIFICATION=

# ── Micro Seed 발행 ─────────────────────────────
# 시스템 User ID (§5-2A). 발행 글의 Post.authorId 가 된다.
#
# 🔴 비어 있으면 발행하지 않는다. 폴백으로 다른 계정을 쓰지 않는다 (§6-9-E) —
#    작성자를 모르는 글이 커뮤니티에 남으면 takedown 대상을 고를 기준이 사라진다.
# 🚫 실회원 계정 ID 를 넣지 않는다. 실회원 이름으로 발행되면 되돌리기 어렵다.
#    시스템 User 는 providerId 가 NULL 이어야 한다(카카오 실회원 판별 기준).
#
# User row 는 별도로 만들어 둔다 — 이 값만 넣는다고 생기지 않는다.
SORAN_MICRO_SEED_AUTHOR_ID=

# 후보 Google Sheet ID. URL 의 /d/ 와 /edit 사이 문자열이다.
#
# 🔴 값 자체는 비밀이 아니지만(접근 권한이 실질 방어다) 실제 값은 .env.local 에만 둔다.
# 🔴 읽기 전용으로만 쓴다 — 스코프가 spreadsheets.readonly 라 토큰이 쓸 수 없다.
#    상태 역기록(postUrl · updatedBySystemAt)은 PR-C2b 에서 스코프와 함께 올린다.
#
# 사전 준비 — 서비스 계정 임퍼소네이션 (키 파일을 만들지 않는다)
#   1. SA 의 [권한] 탭에 roles/iam.serviceAccountTokenCreator (로그인 계정 대상)
#      🔴 프로젝트 IAM 이 아니다
#   2. gcloud auth application-default login \
#        --impersonate-service-account=micro-seed-reader@project-8687edda-dc1b-4c7d-95a.iam.gserviceaccount.com
#      🔴 --scopes 를 붙이지 않는다. 사용자 동의로 Sheets 스코프를 요청하면
#         Google 이 "차단된 앱" 으로 막는다 — Sheets 스코프는 SA 토큰이 갖는다
#   3. GCP 에서 sheets.googleapis.com 활성화
#   4. 그 SA 를 시트에 공유 (뷰어면 충분하다)
SORAN_MICRO_SEED_SHEET_ID=

# ── 선택 ────────────────────────────────────────
# 발행 heartbeat 알림
SLACK_WEBHOOK_URL=
