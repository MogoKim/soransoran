// 소란소란 DB 스키마 초안
//
// 🔴 우나어의 schema.prisma(46모델 · 1,547행)를 복사하지 않았다.
//    D-day 에 필요한 최소 모델만 둔다.
//
// 🔴 migration apply 는 이 커밋에서 하지 않는다.
//    스키마 반영은 창업자 승인 후 별도 절차로 진행한다.
//    prisma migrate / db push / db seed 는 사용하지 않는다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────── 게시판 ───────────
// IA 정본: 갱년기톡 · 자유게시판 = 게시판 / 매거진 = 콘텐츠 영역
enum BoardType {
  MENOPAUSE
  FREE
  MAGAZINE
}

enum PostStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

// 🔴 우나어에는 Comment.source 컬럼이 없어 봇/실회원 판별이
//    authorId → User.providerId 조인이었다. 소란소란은 처음부터 컬럼으로 둔다.
enum AuthorSource {
  USER
  SYSTEM
}

// 🔴 AuthorSource 를 확장하지 않는다. 두 질문은 다른 축이다.
//    AuthorSource  = "사람이 썼나"        (USER / SYSTEM)
//    CommentOrigin = "어느 레인에서 왔나" (MEMBER / PERSONA / MICRO_SEED_VERBATIM)
//    한 필드가 두 질문에 답하게 하면 분류가 무너진다.
//    실회원 댓글은 source=USER + commentOrigin=MEMBER 로 그대로 유지된다.
//    정본: docs/constitution/MICRO_SEED_LANE_CONSTITUTION.md §8-6
enum CommentOrigin {
  MEMBER              // 실회원이 직접 쓴 댓글
  PERSONA             // 페르소나가 생성한 댓글
  MICRO_SEED_VERBATIM // 원문 댓글을 그대로 사용한 Micro Seed 댓글
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

// ─────────── 회원 (NextAuth) ───────────
model User {
  id            String    @id @default(cuid())
  name          String?
  // 🔴 카카오 닉네임을 여기에 자동 저장하지 않는다.
  //    중복 닉네임이면 unique 위반으로 가입 자체가 실패하기 때문이다.
  //    가입 시에는 name 만 채우고, nickname 은 사용자가 직접 설정할 때만 쓴다.
  //    (NULL 은 여러 행이 허용되므로 unique 제약을 남겨도 안전하다)
  nickname      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // 카카오 providerId. 실회원 판별 기준이 된다.
  providerId    String?   @unique

  isAdmin       Boolean   @default(false)
  isBlocked     Boolean   @default(false)

  // 카카오 동의 항목. 아직 받지 않는다 — 그릇만 세운다.
  //
  // 🔴 전부 nullable 이다. 이미 가입한 회원이 있어 NOT NULL 은 적용 자체가 실패한다.
  //    "필수" 는 컬럼 제약이 아니라 가입 게이트가 정한다.
  //
  // 🔴 birthyear 는 문자열이다. 숫자로 바꾸지 않는다 —
  //    카카오가 주는 값은 "1975" 같은 문자열이고, Number("0000") 은 0 이 되어
  //    조용히 저장된다. 연산할 일이 생기면 그때 읽는 쪽에서 판단한다.
  //
  // 🔴 phoneNumber 에 @unique 를 걸지 않는다. 가족이 한 번호를 함께 쓰는 경우가 있고,
  //    unique 는 그 사람의 가입을 이유도 없이 막는다.
  gender             String?
  birthyear          String?
  phoneNumber        String?
  /// 성별·출생연도·전화번호를 받은 시각
  profileConsentAt   DateTime?
  /// 광고성 정보 수신 동의 시각. 전화번호 수집 동의와는 다른 축이다 —
  /// 번호를 받았다는 사실은 발송 근거가 되지 않는다.
  marketingConsentAt DateTime?
  /// 첫 로그인 온보딩(닉네임·약관)을 마쳤는가. 기존 회원은 false 로 시작해 한 번 거친다.
  isOnboarded        Boolean   @default(false)

  /// 첫 가입 인사를 남긴 시각. 최초 1회만 기록된다.
  ///
  /// 🔴 이 값이 있으면 첫 인사 위젯을 다시 띄우지 않는다.
  ///    글을 지워도 남아야 하므로 Post 가 아니라 여기에 둔다.
  firstGreetingAt     DateTime?
  /// 첫 가입 인사 글의 id.
  ///
  /// 🔴 FK 를 걸지 않는다.
  ///    이 값의 목적은 "이미 인사를 했다" 를 기억하는 것이다. FK + Cascade 면
  ///    글을 지운 순간 이력도 사라져 위젯이 다시 뜬다 — 막으려던 일이 그것이다.
  firstGreetingPostId String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  scraps        Scrap[]
  reports       Report[]      @relation("Reporter")
  blocking      UserBlock[]   @relation("Blocker")
  blockedBy     UserBlock[]   @relation("Blocked")
  agreements    Agreement[]

  /// 🔴 이 회원이 페르소나인가 — 존재 여부가 유일한 답이다.
  ///    User 에 isPersona 플래그를 두지 않는다 (설계 §3-1)
  persona              Persona?
  /// 페르소나가 이 회원에 대해 가진 관계 기억. 🔴 탈퇴 시 Cascade 로 삭제된다
  personaRelationships PersonaUserRelationship[]

  @@index([createdAt])
}

/// 동의 이력. 무엇에 언제 동의했는지 남긴다.
///
/// 🔴 User 의 플래그만으로는 "언제 어느 판본에 동의했는가" 를 답할 수 없다.
///    약관이 바뀌면 다시 받아야 하고, 그때 필요한 것이 version 이다.
///
/// 🔴 type 은 문자열이다. enum 으로 두면 항목이 하나 늘 때마다 migration 이 필요하다.
///    쓰는 값: 'TERMS_OF_SERVICE' | 'PRIVACY_POLICY' | 'MARKETING'
model Agreement {
  id        String   @id @default(cuid())
  userId    String
  type      String
  version   String
  agreedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 같은 판본에 두 번 동의한 것으로 기록되지 않는다. 재동의는 upsert 로 agreedAt 만 갱신한다.
  @@unique([userId, type, version])
  @@index([userId])
  @@index([type])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// 🔴 JWT 전략(session.strategy = 'jwt')에서는 이 테이블을 사용하지 않는다.
//    PrismaAdapter 가 User·Account 만 저장하고 Session 은 비어 있는 것이 정상이다.
//    database 전략으로 전환할 때를 대비해 모델만 남겨둔다.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────── 글 ───────────
model Post {
  id        String       @id @default(cuid())
  boardType BoardType
  title     String
  content   String       @db.Text
  status    PostStatus   @default(PUBLISHED)
  source    AuthorSource @default(USER)

  /// 콘텐츠 종류. 일반 글은 null 이고, 첫 가입 인사만 '가입인사' 다.
  ///
  /// 🔴 노출 여부를 뜻하는 축이 아니다.
  ///    "검색에 넣을까 · 추천에 올릴까" 는 아래 3축 플래그가 답한다.
  ///    한 컬럼이 두 질문에 답하게 두면 언젠가 한쪽이 틀린다.
  ///
  /// 🔴 null 을 잃지 않도록 거른다.
  ///    `category != '가입인사'` 단독 비교는 Postgres 3-value logic 상
  ///    null 행을 함께 제외해 일반 글이 통째로 사라진다.
  ///    greeting-policy.ts 의 EXCLUDE_GREETING 을 쓴다.
  category  String?

  authorId  String
  // onDelete 를 지정하지 않아 기본 Restrict 다 — 글이 있으면 User 삭제가 막힌다.
  // 회원 탈퇴/익명화 정책은 private preview 범위 밖이므로 삭제 기능을 만들지 않는다.
  // 정책 확정 시 SetNull(익명화) 또는 Cascade(삭제) 중 선택한다.
  author    User         @relation(fields: [authorId], references: [id])

  /// 이 글을 쓴 페르소나. 실회원 글은 null 이다.
  ///
  /// 🔴 세 번째 축이다. AuthorSource 를 확장하지 않는다 —
  ///    AuthorSource = "사람이 썼나" · personaId = "누가 썼나".
  ///    41~44행 주석이 정한 원칙 그대로다.
  /// 🔴 postOrigin enum 을 만들지 않는다. personaId 만으로 판별된다 —
  ///    같은 질문에 답하는 축을 둘 두면 언젠가 어긋난다.
  /// 🔴 authorId → User → Persona join 으로 대신하지 않는다.
  ///    takedown 이 급할 때 join 이 하나 더 붙는다. 쓸 곳이 이미 있다.
  /// 🔴 Restrict 다. 이 글이 있으면 Persona 삭제가 막힌다 —
  ///    페르소나는 지우는 것이 아니라 status=retired 로 끄는 것이고,
  ///    SetNull 이면 "어느 페르소나가 썼는지" 를 영구히 잃는다.
  ///    외부 비공개 정책에서 그 추적성이 유일한 통제 수단이다(전략 §10-3).
  personaId String?
  persona   Persona?     @relation(fields: [personaId], references: [id], onDelete: Restrict)

  // ── Micro Seed 게이트 (M0) ─────────────────────────────
  // 정본 §3 C-1: 생성 시점에 확정되고 일반 운영 경로로는 변경되지 않는다.
  //   승인된 one-off repair/migration 만 예외이며 감사 로그를 남긴다.
  // 판정은 src/lib/post-visibility.ts 3축 함수가 유일한 지점이다 (C-2).
  //   각 파일에서 이 값을 직접 비교하지 마라.
  /** Micro Seed 레인 발행물인가. 커뮤니티에는 보이되 색인·추천에서는 빠진다. */
  isMicroSeed           Boolean @default(false)
  /** 영구 noindex. index 전환은 영구 금지다 (정책 8·10). */
  permanentNoindex      Boolean @default(false)
  /** 승격·추천 write-path 차단 (정책 9·10 · C-4). */
  indexPromotionBlocked Boolean @default(false)

  // ── M1 Founder Gate 역조회 (정본 §5-2-3) ────────────────
  // 🔴 이 필드들이 있어야 takedown 이 실행 가능하다 (§6-6).
  //    "원문 삭제 요청이 왔다 → 어느 글인가" 를 답하는 유일한 경로다.
  //    우나어 네이버 시정 요청 때 역조회 수단이 없어 실제로 고생했다.
  //
  // 🚫 dedupKey 를 여기 두지 않는다. MicroSeedCandidate 에만 둔다.
  //    sheetCandidateId @unique 가 Post 쪽 중복을 이미 막으므로
  //    두 곳에 두면 동기화 부채만 생긴다 (§5-2-3).
  //
  // 전부 nullable 이다. 회원 글(대다수)에는 채워지지 않는다.
  /** Sheet 후보 행의 불변 id. 양방향 키의 한쪽이다 (§6-1). */
  sheetCandidateId String?   @unique
  /** 82cook · navercafe:{cafeId} */
  sourceSite       String?
  /** 원문 URL. takedown 역조회의 1차 키다. */
  sourceUrl        String?
  /** 원문 글 id. Post.id 와 혼동하지 않도록 Article 로 명명한다. */
  sourceArticleId  String?
  sourceCapturedAt DateTime?

  // 🔴 예약 발행 시각이지 SEO 허용 신호가 아니다.
  //    3축 판정(post-visibility.ts)에 이 값을 넣지 마라.
  //    후보의 scheduledPublishAt(창업자 입력)과 이름을 분리한 이유는 §5-2-3.
  publishAt DateTime?

  viewCount Int          @default(0)
  /// 공감 수. Like row 를 세지 않고 담아 둔다 — 목록으로 옮길 때 행마다 세는 일을 피한다.
  /// 쓰는 곳은 togglePostLike 한 곳뿐이다. 정렬·인기·베스트에는 아직 쓰지 않는다.
  likeCount Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  comments  Comment[]
  likes     Like[]
  scraps    Scrap[]
  reports   Report[]

  @@index([boardType, status, createdAt])
  @@index([authorId])
  @@index([personaId])
  // sitemap 등 색인 대상 조회 — SEARCH_INDEXABLE_WHERE 와 짝이다.
  @@index([status, isMicroSeed, permanentNoindex])
  // takedown 역조회 — sheetCandidateId(@unique) 와 함께 §6-6 의 성립 조건이다.
  @@index([sourceUrl])
}

// ─────────── 댓글 ───────────
model Comment {
  id        String       @id @default(cuid())
  content   String       @db.Text
  source    AuthorSource @default(USER)
  // 🔴 source 와 별개 축이다. source=USER 인 실회원 댓글은 그대로 MEMBER 다.
  //    정본 §8-6. AuthorSource 확장으로 처리하지 않는다.
  commentOrigin CommentOrigin @default(MEMBER)

  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])

  /// 이 댓글을 쓴 페르소나. 실회원 댓글은 null 이다.
  ///
  /// 🔴 commentOrigin 과 별개 축이다.
  ///    commentOrigin = "어느 레인에서 왔나"(MEMBER/PERSONA/MICRO_SEED_VERBATIM)
  ///    personaId     = "어느 페르소나가 썼나"
  ///    commentOrigin 만으로는 레인만 알 뿐 누구인지 모른다.
  /// 🔴 CommentOrigin 의 기존 의미를 바꾸지 않는다. 값도 늘리지 않는다.
  /// 🔴 Restrict — Post.personaId 와 같은 이유다
  personaId String?
  persona   Persona?     @relation(fields: [personaId], references: [id], onDelete: Restrict)

  parentId  String?
  parent    Comment?     @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]    @relation("CommentReplies")

  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  reports   Report[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([personaId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

/// 나중에 다시 보려고 담아 둔 글.
///
/// 🔴 Like 와 같은 모양으로 둔다 — @@unique 도 [postId, userId] 순서를 맞춘다.
///    두 테이블의 키 순서가 다르면 읽는 사람이 매번 어느 쪽인지 확인해야 한다.
///
/// 🔴 scrapCount 를 만들지 않는다. 스크랩 수는 어느 화면에도 표시하지 않는다 —
///    쓰지 않는 카운터는 토글마다 Post 행을 잠그기만 한다.
///    보여주기로 결정한 날 그때 만든다.
model Scrap {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  /// 내 스크랩 목록은 최신순이다. 정렬까지 index 가 받아 준다.
  @@index([userId, createdAt(sort: Desc)])
}

// ─────────── 보호장치 ───────────
// D-day 최소 보호장치. 신고는 D-day 필수다.
model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id])

  postId     String?
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reason     String
  detail     String?      @db.Text
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
}

// 🔴 우나어는 UserBlock 을 저장만 하고 어떤 쿼리도 필터로 쓰지 않는다.
//    소란소란은 목록·상세 쿼리에 필터를 반드시 적용한다.
//    차단 UI 를 숨기더라도 필터는 처음부터 넣는다.
model UserBlock {
  id            String   @id @default(cuid())
  blockerId     String
  blocker       User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockerId])
}

// ─────────── 매거진 CTA 클릭 ───────────
// 매거진 글이 커뮤니티 행동으로 이어지는지 보는 진단선이다.
// 🔴 클릭 수 자체는 North Star 가 아니다. North Star 는 회원이 남긴 글·댓글이다.
//    North Star 가 안 움직일 때 "안 왔는지 / 왔는데 안 눌렀는지" 를 가르는 용도로만 쓴다.
//
// 🔴 개인정보를 저장하지 않는다 — userId·IP·User-Agent·Referer 전부 없다.
//    같은 사람의 중복 클릭은 세지 못하는 채로 둔다.
//    구분하려면 쿠키를 심어야 하는데, 그 순간 성격이 달라지므로 넣지 않는다.
//
// slug 는 Post 가 아니라 파일(src/content/magazine/articles.ts)의 글을 가리키므로 FK 가 아니다.
model MagazineClick {
  id        String   @id @default(cuid())
  slug      String
  boardSlug String
  createdAt DateTime @default(now())

  @@index([slug, createdAt])
  @@index([createdAt])
}

// ─────────── Micro Seed Founder Gate (M1) ───────────
//
// 정본: docs/constitution/MICRO_SEED_LANE_CONSTITUTION.md §5-2 · §6
//
// 🔴 DB 가 진실의 원장이고 Google Sheet 는 미러다 (정책 16 · §5-2-0).
//    Sheet 단독으로 가지 않는 이유는 하나다 — Sheets API 에는 compare-and-set 이 없어
//    두 워커가 같은 행을 읽고 둘 다 PROCESSING 을 쓸 수 있다.
//    즉 Sheet 만으로는 중복 발행을 구조적으로 막을 수 없다.
//    DB 의 `UPDATE ... WHERE status='PENDING'` 원자성이 1차 방어의 전부다 (§6-10).
//
// 이 migration 은 원장만 세운다. 후보 적재 · 발행 코드는 이후 PR 이다.

/// §6-2 상태 기계. 8상태에서 늘리거나 줄이지 않는다.
/// 🔴 ReportStatus.PENDING(신고)과 이름이 겹치므로 타입 접두를 붙여 구분한다.
enum MicroSeedCandidateStatus {
  HOLD       // 기본값. 후보 보관. 알 수 없는 값도 여기로 떨어진다 (C-6)
  PENDING    // 창업자 발행 승인 — 사람만 설정 가능. 자동 경로를 만들지 않는다
  PROCESSING // worker 획득. processingStartedAt · processingBy 를 같은 UPDATE 에서 쓴다
  PUBLISHED  // DB 발행 성공을 확인한 뒤에만. 🔴 비가역
  FAILED     // 발행 실패. 사유 기록 필수
  SKIPPED    // 중복 · 이미 발행됨. DB 실측 결과
  DECLINED   // 창업자 반려. 사유 기록 필수
  TAKEDOWN   // 삭제/숨김 대상. Post.status = HIDDEN 과 쌍으로 (§6-6)
}

/// Micro Seed 후보 원장. Sheet 행 1개 = 이 테이블 1행.
model MicroSeedCandidate {
  /// = Sheet 의 candidateId. 🔴 불변이며 행 번호를 대신한다.
  ///    Sheet 정렬·삽입·삭제로 행 번호가 흔들려도 이 값으로 매칭한다 (§6-4).
  id     String                   @id @default(uuid())
  status MicroSeedCandidateStatus @default(HOLD)

  // ── 원문 출처 ────────────────────────────────────────
  sourceSite      String
  sourceUrl       String
  sourceArticleId String
  sourceBoardName String?
  /// 🟢 정책 3 — 좋은 원문의 1순위 신호. 왜 이 후보가 뽑혔는지의 근거값이다.
  sourceCommentCount Int      @default(0)
  sourceCapturedAt   DateTime

  // ── 원문 본문 참조 (M2) ──────────────────────────────
  /// 발행에 쓸 원문 제목·본문·댓글은 MicroSeedRawContent 에 있다.
  ///
  /// 🔴 명시 FK 로 잇는다. dedupKey 조인에 의존하지 않는다 —
  ///    dedupKey 는 Sheet M열이라 사람이 고칠 수 있고(§6-8 R11),
  ///    사람이 만질 수 있는 값에 참조 무결성을 걸면 안 된다.
  ///
  /// nullable 인 이유: 후보가 먼저 적재되고 본문이 나중에 붙는 순서를 허용한다.
  /// 🔴 본문 없이 발행되지는 않는다 — G-A 가 content 빈 값을 HOLD 로 막는다.
  rawContentId String?              @unique
  rawContent   MicroSeedRawContent? @relation(fields: [rawContentId], references: [id], onDelete: SetNull)

  // ── 중복 방어 2차 (§6-10) ────────────────────────────
  /// sha256(`${sourceSite}::${sourceArticleId}`).
  /// collector 가 같은 원문을 두 번 담아도 DB 가 거부한다.
  dedupKey String @unique

  // ── 창업자 입력 (Sheet 편집 칸) ──────────────────────
  /// 원제 보존. founderTitle 과 비교해야 무엇을 고쳤는지 알 수 있다.
  originalTitle String
  /// 실제 발행 제목. 2~120자 (post-policy.ts 와 같은 값, R3)
  founderTitle  String?
  /// 🔴 BoardType 에 MAGAZINE·BEST 가 실재하므로 타입만으로는 못 막는다.
  ///    FREE / MENOPAUSE 화이트리스트는 publisher 코드가 강제한다 (§6-9-D · R2).
  targetBoardType    BoardType?
  /// 창업자가 적는 희망 시각(입력). Post.publishAt(결과)과 이름을 분리한다 (§5-2-3).
  /// 과거 시각이면 즉시 발행하지 않고 HOLD 다 (R5).
  scheduledPublishAt DateTime?

  // ── worker 상태 ──────────────────────────────────────
  // 🔴 Sheet 에 두지 않는다. 사람이 만지면 timeout 판정과 재시도 차단이 깨진다 (§6-7-B).
  /// timeout 판정의 유일한 근거 (§6-3)
  processingStartedAt DateTime?
  /// worker/run id — 중복 실행 감지
  processingBy        String?
  /// 무한 재시도 차단. 상한 3 초과 시 FAILED 고정 (§6-9-F)
  attemptCount        Int       @default(0)
  processedAt         DateTime?

  // ── 결과 · 사유 ──────────────────────────────────────
  /// 발행 결과. Post.sheetCandidateId 와 짝을 이루는 양방향 키다 (§6-1).
  createdPostId String? @unique
  // 🔴 사유 3개를 하나로 합치지 않는다. 성격이 다르고 추적 질문도 다르다.
  /// 왜 HOLD 인가 (검증 실패 · timeout 복귀 · 예약 경과)
  holdReason    String?
  /// 창업자 반려 사유
  declineReason String?
  /// 발행 실패 사유
  failureReason String?

  founderApprovedBy String?
  founderApprovedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history MicroSeedCandidateHistory[]

  /// PENDING 픽업 — 예약시각이 지난 승인 후보를 고른다
  @@index([status, scheduledPublishAt])
  /// timeout 스캔 — PROCESSING 중 오래된 것을 찾는다 (§6-3)
  @@index([status, processingStartedAt])
  /// takedown 역조회 — 원문 URL 로 후보를 찾는다 (§6-6)
  @@index([sourceUrl])
}

/// 상태 전이 감사. §6-4 "되돌리기" 방어의 근거다.
/// 이게 없으면 창업자가 무엇을 언제 왜 바꿨는지 알 수 없다.
model MicroSeedCandidateHistory {
  id          String             @id @default(cuid())
  candidateId String
  candidate   MicroSeedCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  /// 최초 적재는 from 이 없다
  fromStatus MicroSeedCandidateStatus?
  toStatus   MicroSeedCandidateStatus
  /// 'founder' | 'worker:{id}' | 'validator'
  by         String
  reason     String?
  at         DateTime                  @default(now())

  @@index([candidateId, at])
}

// ─────────────────────────────────────────────────────────
// 원문 보관 — M2 발행에 필요한 최소본
// ─────────────────────────────────────────────────────────
//
// 정본: docs/constitution/MICRO_SEED_LANE_CONSTITUTION.md §10-3 · §10-5 · §11-2
//
// 🔴 이것은 M5 Voice Vault 가 아니다
//    §12 마일스톤에서 Raw / Derived / Publishing Input 3계층 자산화는 M5 다.
//    여기는 M2("본문 발행 · 원문 그대로 사용")가 당장 필요로 하는 것만 담는다.
//    Derived Vault · Publishing Input · persona/voice 학습 자산 필드를 넣지 않는다.
//
// 🔴 왜 Sheet 가 아니라 DB 인가
//    Sheet 17열에 content 열을 추가하지 않는다(§6-7-B 정책 22). 5,000자 본문이
//    셀에 들어가면 창업자가 승인 화면에서 스크롤만 하게 된다.
//
// 🔴 왜 발행 시점 재수집이 아닌가
//    원문은 삭제된다("펑"). 승인 시점에 있던 글이 발행 시점에 없을 수 있고,
//    그때는 무엇을 발행하려 했는지조차 남지 않는다. 수집 시점에 담아 둔다.
//
// 🚫 §5-5 "넣으면 과한 것" 을 지킨다
//    sourceAuthorHash · sourceBoardCategory 는 Voice Vault(M5) 영역이라 넣지 않는다.

/// §10-3 · §10-5. 우나어 legacy 는 직접 발행 소스가 아니다 (정책 12).
enum MicroSeedRawOrigin {
  /// 82cook · 네이버 카페 등 live source. Micro Seed 발행 가능
  live
  /// 우나어 legacy. 🔴 학습·분석 자산이며 **직접 발행 금지**.
  /// §10-1 은 "문서 규칙으로만 두지 않고 후보 쿼리에서 코드로 배제" 하라고 요구한다.
  /// publisher 는 origin='unao_legacy' 를 조회 단계에서 제외해야 한다.
  unao_legacy
}

/// 원문 1건 = 이 테이블 1행. MicroSeedCandidate 와 1:1 이다.
model MicroSeedRawContent {
  id     String             @id @default(uuid())
  /// 🔴 기본값을 live 로 두지 않는다. 적재 주체가 명시하게 한다 —
  ///    legacy 를 실수로 live 로 넣으면 정책 12 가 조용히 뚫린다.
  origin MicroSeedRawOrigin

  // ── 출처 ─────────────────────────────────────────────
  sourceSite       String
  sourceUrl        String
  sourceArticleId  String
  sourceCapturedAt DateTime

  // ── 원문 ─────────────────────────────────────────────
  rawTitle String
  /// 5,000자 상한은 발행 게이트(G-A)가 본다. 저장은 원형 그대로 한다 —
  /// 자르면 "그대로 사용"(정책 7)이 아니게 되고 되돌릴 수도 없다.
  rawBody  String @db.Text

  /// 원문 댓글 원형. **M2 는 댓글을 발행하지 않는다** — 댓글 활성화는 M3 다.
  ///
  /// 🔴 지금 JSON 인 이유
  ///    M3 스펙(반응 지도 · 댓글 유형 분포 · 인용 적합성 라벨)이 아직 없다.
  ///    모르는 스펙으로 컬럼을 정하면 M3 에서 다시 바꿔야 한다.
  ///    그렇다고 수집을 미루면 원문이 삭제됐을 때 영영 못 가져온다.
  ///    → 원형만 담아 두고, 구조는 M3 에서 정한다.
  ///
  /// 🔴 M3 에서 별도 테이블로 승격해야 한다
  ///    §M3 완료 조건이 "댓글 출처 역추적 가능" 이고 §11-2 는 삭제 요청 시
  ///    **댓글 단위** 역조회를 요구한다. JSON 으로는 댓글 하나만 내릴 수 없다.
  ///    승격 전까지 이 컬럼의 댓글을 발행에 쓰지 않는다.
  ///
  /// 형태: [{ id?, contentHash?, body, at? }] — §10-3 은 "개별 id 또는 contentHash" 를 요구한다.
  rawComments Json?

  // ── 원문 생존 · 보존 ─────────────────────────────────
  /// 🔴 §10-3 이 "이것이 중요하다" 고 명시한 필드.
  ///    우나어는 발행 직전 게이트로만 사후 대응했고 **이미 저장된 원문의 삭제는
  ///    감지하지 못했다.** 감지 스캐너는 이후 PR 이며 여기서는 자리만 둔다.
  deletedDetectedAt DateTime?

  /// 보존 만료 예정 시각.
  ///
  /// 🔴 자동 삭제를 구현하지 않는다. 이 필드는 "언제까지 두기로 했는가" 의 기록이다.
  ///    파기는 §6-6 이 요구하는 대로 사람이 판단해 별도 절차로 밟는다.
  ///
  /// 기본 정책: 후보가 터미널 상태(PUBLISHED · DECLINED · SKIPPED · FAILED · TAKEDOWN)에
  ///           들어간 뒤 **90일**. 그 시점에 값을 채운다.
  /// active 후보(HOLD · PENDING · PROCESSING)는 **null 이다** — 아직 만료를 셀 수 없다.
  ///
  /// ⚠️ 정본 TODO-9(Voice Vault 보존 정책)는 아직 미확정이다. 확정되면 이 기본값을 갱신한다.
  retentionUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate MicroSeedCandidate?

  /// collector 중복 적재 차단.
  /// 🔴 dedupKey 문자열이 아니라 이 테이블 자신의 필드로 잠근다 —
  ///    dedupKey 는 Sheet 를 거치며 사람 손을 탈 수 있다 (§6-8 R11).
  @@unique([sourceSite, sourceArticleId])
  /// §10-1 legacy 배제 쿼리 — publisher 가 origin='unao_legacy' 를 걸러낸다
  @@index([origin])
  /// §11-2 takedown 역조회 — 원문 URL 로 찾는다
  @@index([sourceUrl])
  /// 원문 삭제 감지 스캔 — 아직 확인하지 않은 것을 고른다
  @@index([deletedDetectedAt])
}


// ═══════════════════════════════════════════════════════════
// Voice Engine 자산 (VE-M1)
//
// 정본: docs/operations/2026-08-27-voice-engine-schema-strategy.md
//
// 🔴 1차 전략 — 참조하되 복제하지 않는다
//    우나어 DB(read-only) 에서 원문을 읽어 분석하고,
//    소란소란 DB 에는 **Derived 자산만** 남긴다.
//    우나어 CafePost.content · topComments[].content · author 닉네임을
//    여기에 대량 복제하지 않는다.
//
// 🔴 이번 PR 범위는 VoiceSource + VoiceJudgment 둘뿐이다.
//    VoiceDerived · VoiceCommentSignal 은 VE-M2 · VE-M3 다.
// ═══════════════════════════════════════════════════════════

/// 창업자(또는 기존 파이프라인)의 판단.
///
/// 🔴 `referenced` 가 `approved` 와 다른 것이 이 enum 의 핵심이다.
///    우나어 `usedAt` 6,494건 중 실제 발행으로 이어진 것은 13건(0.2%)뿐이다.
///    스키마 주석도 "큐레이션 참조 시각" 이다 —
///    approved 로 넣으면 "사람이 승인했다" 는 거짓 정답지가 만들어진다.
///
/// 🔴 String 이 아니라 enum 인 이유: 이 5값은 Voice Engine 이 학습할 정답지의
///    라벨이다. 오타 하나가 조용히 학습 데이터를 오염시킨다.
enum VoiceJudgmentDecision {
  /// 승인해 발행까지 간 것
  approved
  /// 보고 보류한 것. 🔴 "아직 안 봤다" 와 구분된다
  held
  /// 명시적으로 제외한 것
  declined
  /// fetch 했으나 원장에 넣지 않은 것.
  /// 🔴 부정 사례를 남기는 유일한 자리다 — 현재 DB 에 행 자체가 없다
  not_imported
  /// 🔴 우나어 usedAt. 큐레이션이 참조했을 뿐 승인이 아니다
  referenced
}

/// Voice Engine 원천 참조. 🔴 원문을 저장하지 않는다.
///
/// 우나어 DB 와 소란소란 DB 는 **별개의 데이터베이스**다.
/// FK 를 걸 수 없어 `origin` + `sourceRef` 문자열로 가리키고,
/// 무결성은 `@@unique([origin, sourceRef])` 로만 지킨다.
/// MicroSeedRawContent 에도 FK 를 걸지 않는다 — 두 출처를 같은 방식으로 다룬다.
model VoiceSource {
  id     String @id @default(uuid())

  /// 'unao_cafe' | 'micro_seed' | 'soransoran_own'
  /// 🔴 enum 이 아니다. M6 multi-source 확장에서 값이 늘어나는데
  ///    그때마다 migration 을 요구하면 source 추가가 schema 작업이 된다.
  origin    String
  /// 원천 레코드의 id. 우나어 CafePost.id · 소란소란 MicroSeedRawContent.id
  /// 🔴 FK 아님 — 다른 DB 를 가리킬 수 있다
  sourceRef String

  sourceSite      String
  /// 🔴 역추적용. 외부 노출 금지 (§10-5-A)
  sourceUrl       String
  sourceBoardName String?

  /// 🔴 닉네임 원문을 저장하지 않는다. 동일인 추적만 가능한 단방향 해시.
  ///    우나어 닉네임은 3~7자라 원문을 두면 검색으로 특정된다.
  authorHash String?

  /// N2 정규화 후의 단방향 해시. Gate ⑥-B displayName 충돌 검사용.
  ///    N2 = trim + NFC + 소문자 + 공백·기호 제거
  ///
  /// 🔴 원문은 여기에도 저장하지 않는다. authorHash 와 같은 salt·같은 방식이다.
  /// 🔴 N3(숫자·영문 제거) 기준 컬럼은 만들지 않는다.
  ///    실측: N3 결과가 빈 문자열 10.4~10.5% · 서로 다른 이름이 12~13% 뭉친다.
  ///    한글 없는 이름이 전부 같아져 근거 없는 충돌이 된다.
  ///    정본: docs/operations/2026-08-31-persona-gate6-nickname-collision-design.md §5-1
  ///
  /// 🔴 authorHash 를 대체하지 않는다. 둘 다 본다 —
  ///    원본 일치와 정규화 일치는 다른 신호다.
  authorHashNorm String?

  postedAt   DateTime?
  capturedAt DateTime

  // ── 원문 스냅샷 — 본문이 아니라 "그때 그 본문이었다" 의 증거 ──
  //    🔴 원문을 복제하지 않는 대가를 메운다. 원문이 삭제·수정되면
  //       Derived 의 근거를 판정할 수 없게 되는데, 해시가 그것을 대신한다.
  contentHash   String?
  contentLength Int?
  commentCount  Int?

  /// 원문 생존 확인 — 헌법 §10-3 이 요구하는 필드
  lastVerifiedAt    DateTime?
  deletedDetectedAt DateTime?

  /// 우나어가 이미 매긴 라벨을 그대로 보존한다 (30,139건 · 재계산 비용 0).
  /// desireCategory · desireType · emotionTags · urgencyLevel ·
  /// communitySignal · ageSignal · viralType · commentSplit · psychInsight …
  /// 🔴 필드로 펼치지 않는다 — 우나어 스키마에 종속되면 그쪽이 바뀔 때 같이 깨진다.
  legacyLabels Json?
  /// 라벨을 만든 쪽의 버전. 'unao-psych-analyzer-v2' 등.
  /// 버전이 바뀌면 같은 필드라도 의미가 달라진다.
  legacyLabelVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  judgments      VoiceJudgment[]
  derived        VoiceDerived[]
  commentSignals VoiceCommentSignal[]
  m3Cache        VoiceM3Cache[]

  /// 🔴 같은 원천을 두 번 등록하지 않는다. FK 가 없으므로 이것이 유일한 방어다.
  @@unique([origin, sourceRef])
  @@index([origin, capturedAt])
  @@index([sourceSite, postedAt])
  @@index([deletedDetectedAt])
}

/// 사람 판단 이력. 🔴 Voice Engine 이 학습할 정답지다.
model VoiceJudgment {
  id            String      @id @default(uuid())
  voiceSourceId String
  voiceSource   VoiceSource @relation(fields: [voiceSourceId], references: [id], onDelete: Cascade)

  decision VoiceJudgmentDecision
  reason   String?               @db.Text
  /// 'founder' | 'unao-curation' | 'system'
  decidedBy String
  decidedAt DateTime @default(now())

  /// 판단 시점의 VoiceDerived id.
  /// 🔴 VoiceDerived 가 생긴 뒤에도 FK 를 걸지 않는다 —
  ///    판단은 그때 본 Derived 를 가리켜야 하는데, Derived 는 규칙이 바뀌면
  ///    새 행으로 다시 계산된다. FK 로 묶으면 과거 판단이 흔들린다.
  ///    "사람이 무엇을 보고 그렇게 정했는가" 가 없으면 정답지가 반쪽이다 —
  ///    Q-1 규칙은 이미 두 번 바뀌었다(PR #72 → #75).
  derivedIdAtDecision String?

  @@index([voiceSourceId, decidedAt])
  @@index([decision, decidedAt])
}

/// 규칙으로 뽑은 문체 신호 (VE-M2).
/// 🔴 이 테이블에 원문 · 댓글 · 닉네임이 없다. 신호만 있다.
///    정본: docs/operations/2026-08-26-voice-derived-m2-design.md
model VoiceDerived {
  id            String      @id @default(uuid())
  voiceSourceId String
  voiceSource   VoiceSource @relation(fields: [voiceSourceId], references: [id], onDelete: Cascade)

  /// 어느 규칙으로 매겼는가. 🔴 Q-1 규칙은 이미 두 번 바뀌었다(PR #72 → #75).
  /// 버전이 없으면 "이 값이 어느 규칙의 산출물인가" 를 나중에 알 수 없다.
  ruleVersion String
  /// 'rule' | 'llm' — 🔴 규칙 산출물과 LLM 산출물을 섞지 않는다.
  /// VE-M2 는 전부 'rule' 이고 LLM 비용이 0이다.
  method String @default("rule")

  /// 🔴 model · promptVersion 은 nullable 이 아니라 빈 문자열 기본값이다.
  ///    Postgres 에서 NULL 은 서로 같지 않아, 이 둘이 NULL 이면
  ///    아래 @@unique 가 중복을 전혀 막지 못한다 — 같은 행이 무한히 쌓인다.
  ///    VE-M2(rule)에서는 둘 다 '' 이고, VE-M3(llm)에서 실제 값이 들어간다.
  model         String @default("")
  promptVersion String @default("")

  // ── VE-M2 신호 6종 — 전부 원문에서 규칙으로 센다 ──
  //    🔴 Json 인 이유: 구조가 아직 열려 있다. 스칼라로 굳히면
  //       신호를 다듬을 때마다 migration 이 필요해진다.

  /// 오타 · 자판 인접 오류 · 반복 입력
  typingArtifacts Json?
  /// `..` `~~` `ㅠㅠ` `^^` · 물음표 / 느낌표 개수
  punctuationHabit Json?
  /// 어절 길이 분포 · 띄어쓰기 편차 · 구어체 붙여쓰기
  spacingVariance Json?
  /// 문단 길이 · 줄바꿈 간격 · 문장 중간 개행
  mobileInputTrace Json?
  /// 🔴 단순 사전이 아니라 다섯 갈래다 (m2-design §3-5):
  ///    sourceSpecific         원출처 호칭 — 82님들 · 우갱님들 · 레테님들 · 은오님들 → 치환 대상
  ///    soransoranRegister     소란소란 내부어 — 소란님들 · 소란소란님들 → 치환 결과
  ///    targetDescriptorRisk   타겟 설명어 — 우리 또래분들 · 50대 여성분들 · 중년 여성분들 ·
  ///                           같은 세대 분들 → 🔴 **생성 금지 신호**. 좋은 치환어가 아니다
  ///    genericCommunityPhrase 일반 커뮤니티 표현 → 학습하고 살린다
  ///    preserveStructure      질문 · 공동체 호출 구조를 살릴지 여부
  communityRegister Json?
  /// 🔴 위 요소가 나타나는 **빈도**. 이 값이 없으면 나중에 남발한다.
  ///    나머지는 "무엇이 있는가" 이고 이 축만이 "얼마나 있어야 자연스러운가" 를 답한다.
  artifactFrequency Json?

  // 🔴 naturalnessScore · voiceRetention · originalityDelta · overSanitizedRisk ·
  //    overMimicryRisk · expressionRisk · sequenceSimilarityRisk 는 **여기 없다**.
  //    전부 "소란소란이 쓴 글 ↔ 원문" 의 비교 축이라 생성물이 있어야 계산된다.
  //    빈 컬럼으로 미리 만들어 두지도 않는다 — 있으면 채우고 싶어지고,
  //    채우면 의미 없는 숫자가 정답지에 남는다. VE-M3 에서 만든다.

  derivedAt DateTime @default(now())

  /// 🔴 같은 원천 · 같은 규칙 · 같은 방법 · 같은 모델 · 같은 프롬프트면 한 행이다.
  ///    model · promptVersion 이 빠지면 Haiku 산출물과 Sonnet 산출물이 같은 키를 다투고,
  ///    프롬프트를 고쳐도 캐시가 깨지지 않는다.
  @@unique([voiceSourceId, ruleVersion, method, model, promptVersion])
  @@index([voiceSourceId, derivedAt])
  @@index([ruleVersion, method])
}

/// 댓글 반응 신호 (VE-M2).
/// 🔴 이름이 `Source` 가 아니라 `Signal` 인 이유는 **댓글 본문을 저장하지 않기 때문**이다.
///    본문이 필요한 순간마다 우나어 DB 를 다시 읽는다(UNAO_READONLY_DATABASE_URL).
model VoiceCommentSignal {
  id            String      @id @default(uuid())
  voiceSourceId String
  voiceSource   VoiceSource @relation(fields: [voiceSourceId], references: [id], onDelete: Cascade)

  /// topComments 배열에서의 순서 (= commentIndex).
  /// 🔴 댓글에 날짜가 없어 이것이 유일한 순서 정보다.
  ordinal Int

  /// 🔴 닉네임 원문이 아니다. 동일인 추적만 가능한 단방향 해시 —
  ///    VoiceSource.authorHash 와 같은 방식이다.
  authorHash String?

  /// N2 정규화 후의 단방향 해시 — VoiceSource.authorHashNorm 과 같은 규칙이다.
  ///
  /// 🔴 여기에도 둔다. 댓글 author 고유 수가 글 author 의 2.2배(27,590 대 12,493)라
  ///    글 쪽에만 두면 더 큰 집합을 방치하게 된다.
  /// 🔴 N3 기준 컬럼은 만들지 않는다 · 원문 저장 금지 — VoiceSource 와 동일
  authorHashNorm String?

  /// 댓글 본문이 아니라 "그때 그 댓글이었다" 의 증거
  contentHash   String?
  contentLength Int

  likeCount  Int @default(0)
  replyCount Int @default(0)

  /// 🔴 199자 이상 댓글이 약 4.0% 다. 모르고 학습하면
  ///    "우리 또래는 200자에서 말을 끊는다" 는 거짓 패턴을 배운다.
  truncated Boolean @default(false)

  /// 규칙 기반 라벨 — 공감 · 질문 · 반박 · 경험공유 · 정보제공
  /// 🔴 String 인 이유: 분류 체계가 아직 굳지 않았다. 굳으면 enum 으로 올린다.
  reactionType String?
  /// 원문의 어느 지점에 반응했는가.
  /// ⚠️ 댓글에 인용 정보가 없어 **대부분 null 이 되는 것이 정상**이다.
  anchorHint Json?

  capturedAt DateTime

  @@unique([voiceSourceId, ordinal])
  @@index([voiceSourceId, likeCount])
  @@index([reactionType])
}

// ══════════════════════════════════════════════════════════
// VE-M3 — LLM 실험 저장 구조 (VE-M3-1)
//
// 정본: docs/operations/2026-08-27-voice-m3-llm-experiment-contract.md
//
// 🔴 이 세 테이블의 존재 이유는 **돈이 새는 것을 막는 것**이다.
//    VE-M2 까지는 비용이 0원이라 실수해도 시간만 잃었다. VE-M3 부터는 다르다.
//      · VoiceM3Cache      같은 원문을 두 번 부르지 않는다
//      · VoiceM3CostEvent  호출 한 번마다 얼마 썼는지 남긴다
//      · VoiceM3Run        실행 단위로 cap 을 걸고 멈춘다
//
// 🔴 원문 · 댓글 · 닉네임 컬럼이 없다. VE-M2 와 같은 원칙이다.
//    원문은 우나어 DB 에 남고 필요할 때마다 read-only 로 읽는다.
// ══════════════════════════════════════════════════════════

/// 실행 상태. 🔴 String 이 아니라 enum 인 이유:
/// 이 값으로 "멈춰야 하는가" 를 판정한다. 오타 하나가 cap 을 무력화한다.
enum VoiceM3RunStatus {
  planned
  running
  completed
  failed
  cancelled
}

/// 캐시 항목의 상태. 실패도 남긴다 — 재시도할지 건너뛸지를 이 값으로 정한다.
enum VoiceM3CacheStatus {
  succeeded
  failed
  skipped
}

/// 비용이 발생한 사건의 종류
enum VoiceM3CostEventType {
  call
  retry
  cache_hit
  estimate
}

/// LLM 실행 단위. 🔴 cap 이 걸리는 자리다.
model VoiceM3Run {
  id     String           @id @default(uuid())
  status VoiceM3RunStatus @default(planned)

  /// 🔴 아래 넷은 cacheKey 구성 요소이기도 하다. 하나라도 바뀌면 다른 실행이다.
  ///    NULL 을 허용하지 않는다 — Postgres 에서 NULL 은 서로 같지 않아
  ///    UNIQUE 가 중복을 막지 못한다 (VoiceDerived 에서 같은 결정을 했다).
  taskVersion         String
  model               String
  promptVersion       String
  outputSchemaVersion String

  // ── cap — 실행 전에 정하고 실행 중에 넘으면 멈춘다 ──
  /// 🔴 건수 cap 만으로는 못 막는다. 3,000자 글이 몰리면 같은 건수에 토큰이 3배다
  itemLimit  Int
  tokenCap   Int
  /// 달러는 소수점이 중요하다. Float 로 두면 반올림이 누적된다
  dollarCap  Decimal @db.Decimal(10, 4)

  startedAt   DateTime?
  completedAt DateTime?

  // ── counters ──
  attempted Int @default(0)
  succeeded Int @default(0)
  failed    Int @default(0)
  skipped   Int @default(0)
  cacheHit  Int @default(0)
  cacheMiss Int @default(0)

  // ── cost ──
  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  totalTokens      Int     @default(0)
  estimatedCostUsd Decimal @default(0) @db.Decimal(10, 4)

  /// 🔴 실패 이유를 버리지 않는다. 무엇이 막았는지가 다음 실행의 입력이다.
  ///    원문이 아니라 **사유 요약**만 담는다.
  errorSummary String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costEvents VoiceM3CostEvent[]

  @@index([status, createdAt])
  @@index([taskVersion, model, promptVersion])
}

/// LLM 산출물 캐시. 🔴 **같은 원문을 두 번 부르지 않는다** — 이 테이블의 존재 이유다.
model VoiceM3Cache {
  id String @id @default(uuid())

  /// 🔴 중복 호출 방지의 핵심.
  ///    sha256(origin + sourceRef + contentHash + ruleVersion
  ///           + taskVersion + model + promptVersion + outputSchemaVersion)
  ///    구성 요소를 개별 컬럼으로도 두는 이유: 나중에 "어느 프롬프트 결과만" 을
  ///    골라내야 하는데, 해시만 있으면 역산할 수 없다.
  cacheKey String @unique

  voiceSourceId String
  voiceSource   VoiceSource @relation(fields: [voiceSourceId], references: [id], onDelete: Cascade)

  // ── cacheKey 구성 요소 ──
  origin    String
  sourceRef String
  /// 🔴 원문이 수정되면 키가 달라져 자동으로 무효화된다
  contentHash String?
  /// 입력이 된 VoiceDerived 의 규칙 버전
  ruleVersion String

  /// 🔴 아래 넷은 NOT NULL 이다. NULL 이면 cacheKey 재구성이 불가능하고,
  ///    "어느 모델의 결과인가" 를 알 수 없어 캐시가 무의미해진다.
  taskVersion         String
  model               String
  promptVersion       String
  outputSchemaVersion String

  /// 'llm' 고정. 🔴 VoiceDerived.method='rule' 과 섞이지 않게 하는 표식이다
  method String @default("llm")

  status VoiceM3CacheStatus @default(succeeded)

  /// LLM 산출물. 🔴 **원문 문장이 들어가면 안 된다.**
  ///    저장 전에 우나어 원문과 20자 연속 대조를 통과해야 한다
  ///    (계약 §H). legacyLabels 경유 유출 전례가 있다(VE-R3.1).
  output Json?

  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  totalTokens      Int     @default(0)
  estimatedCostUsd Decimal @default(0) @db.Decimal(10, 4)

  generatedAt DateTime @default(now())

  /// 실패도 남긴다 — 같은 실패를 반복하지 않기 위해서다
  errorCode    String?
  errorMessage String? @db.Text

  costEvents VoiceM3CostEvent[]

  @@index([voiceSourceId, generatedAt])
  @@index([origin, sourceRef])
  @@index([model, promptVersion, taskVersion])
  @@index([status, generatedAt])
}

/// 호출 한 번마다의 비용. 🔴 **retry 도 여기 남는다** —
/// cap 밖에 두면 실패가 많을수록 비용이 커지는 구조가 된다(계약 §E).
model VoiceM3CostEvent {
  id String @id @default(uuid())

  runId String
  run   VoiceM3Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// 🔴 optional 이다. cap 초과로 **호출조차 못 한 사건**도 기록해야 하는데,
  ///    그때는 캐시 행이 없다.
  cacheId String?
  cache   VoiceM3Cache? @relation(fields: [cacheId], references: [id], onDelete: SetNull)

  eventType VoiceM3CostEventType
  model     String

  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  totalTokens      Int     @default(0)
  estimatedCostUsd Decimal @default(0) @db.Decimal(10, 4)

  /// 0 = 최초 시도. 1 이상이면 재시도다
  retryAttempt Int @default(0)
  /// 사유 요약. 🔴 원문을 넣지 않는다
  reason String? @db.Text

  occurredAt DateTime @default(now())

  @@index([runId, occurredAt])
  @@index([cacheId])
  @@index([eventType, occurredAt])
}
// ═══════════════════════════════════════════════════════════════
//  Persona — 소란소란 운영 페르소나
//
//  정본: docs/operations/2026-08-31-persona-db-model-design.md
//  정책: 전략 §10 외부 비공개 / 내부 어드민 명확 구분
//
//  🔴 고객 화면에는 일반 회원처럼 보인다. display-name.ts 는 User 만 읽고,
//     이 모델들을 모른다 — 그대로 두는 것이 정책이다.
//  🔴 내부에서는 Persona.userId 의 존재가 "이 회원은 페르소나다" 의 유일한 답이다.
//     User 에 isPersona 플래그를 두지 않는다 — 두 값이 어긋나는 날이 온다.
// ═══════════════════════════════════════════════════════════════

enum PersonaStatus {
  draft // 정의만 있고 켜지 않았다
  active // 운영 중
  paused // 일시 중지 — 운영자가 언제든
  retired // 은퇴. 🔴 active 로 되돌리지 않는다
}

enum PersonaAuditAction {
  created
  approved
  updated
  status_changed
  retired
  display_name_assigned
  display_name_retired
}

enum PersonaActivityKind {
  post
  comment
}

/// 페르소나 정의. 🔴 User 와 1:1 이되 분리한다.
///
/// 분리하는 이유 — User 에 필드를 얹으면 실회원 행에 전부 nullable 로 붙고,
/// 회원 조회마다 딸려 오며, 고객 화면 코드가 Persona 를 알게 된다.
/// 1:1 로 잇는 이유 — Post.authorId · Comment.authorId 가 NOT NULL 이라
/// 페르소나도 User 행이 있어야 글을 쓸 수 있다.
model Persona {
  id String @id @default(cuid())

  /// 🔴 내부 코드(P01~). 외부 노출 금지. 어드민에서 displayName 뒤에 항상 붙는다
  code String @unique

  /// 🔴 @unique. 한 User 는 최대 하나의 Persona 다
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status      PersonaStatus @default(draft)
  activatedAt DateTime?
  pausedAt    DateTime?
  retiredAt   DateTime?

  /// 🔴 displayName 을 여기 두지 않는다. 정본은 User.nickname 이다.
  ///    둘 다 두면 한쪽만 바꾸는 날이 반드시 온다 (설계 §4).
  ///    대신 폐기한 이름만 여기 남긴다 — 지우면 다음 작명에서 다시 나온다.
  ///    Gate ⑥-B 의 B3 대조가 이 배열까지 본다 (설계 §9).
  retiredDisplayNames String[] @default([])

  /// 7층 구조 §1. 🔴 정확한 나이 · 시·구 지명 · 병명을 넣지 않는다
  identity Json?

  /// 🔴 밴드만. 40대 후반 / 50대 초반 / 50대 후반 / 60대 초반 (헌법 §9-3)
  ageBand   String?
  /// 수도권 / 광역시 / 중소도시 / 읍면 — 🔴 시·구 금지
  region    String?
  lifeStage String?

  /// 말끝 · 길이 · 존댓말 강도 · 이모티콘 · 오타 습관
  voiceCore       Json?
  /// 🔴 테이블로 빼지 않는다. 3~5개이고 항상 함께 읽는다
  voiceVariations Json?

  /// { activeHours: [[9,12],[20,22]], weekdayBias, burstiness }
  /// 🔴 밴드·확률로 둔다. 정확한 시각 목록은 그 자체가 봇 패턴이다
  activityRhythm Json?

  noGoTopics             String[] @default([])
  noGoExpressions        String[] @default([])
  forbiddenReactionRoles String[] @default([])

  /// 🔴 상한만 둔다. 사용량은 PersonaActivityLog 에서 센다 —
  ///    여기 카운터를 두면 발화마다 이 행을 잠근다 (0012_scrap 과 같은 판단)
  dailyCap    Int?
  weeklyCap   Int?
  /// 침묵 확률 0~1. 🔴 forbiddenReactionRoles(하드 차단)와 다른 축이다
  silenceRate Decimal? @db.Decimal(4, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moodStates        PersonaMoodState[]
  selfMemories      PersonaSelfMemory[]
  relationships     PersonaUserRelationship[]
  communityMemories PersonaCommunityMemory[]
  negativeMemories  PersonaNegativeMemory[]
  approvalQueue     PersonaApprovalQueue[]
  auditLogs         PersonaAuditLog[]
  activityLogs      PersonaActivityLog[]

  /// 🔴 이 페르소나가 쓴 글·댓글. Restrict 라 남아 있으면 Persona 삭제가 막힌다
  posts    Post[]
  comments Comment[]

  @@index([status])
}

/// 그날의 mood. 🔴 Persona 컬럼으로 두면 어제 mood 를 알 수 없다 —
/// 생성물이 이상할 때 그날 mood 를 되짚는 것이 첫 단서다.
model PersonaMoodState {
  id        String  @id @default(cuid())
  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  /// KST 날짜 (YYYY-MM-DD). 🔴 시각이 아니라 날짜다
  date String
  mood String
  /// 재현용 seed. 🔴 같은 날 같은 mood 가 나오게 한다
  seed String?

  createdAt DateTime @default(now())

  @@unique([personaId, date])
  @@index([date])
}

// ── Memory 4종 ────────────────────────────────────────────
//    🔴 한 테이블에 두지 않는다. Relationship 만 회원을 가리키고,
//       그것만 회원 탈퇴 시 즉시 삭제해야 한다.
//       합치면 지울 대상을 필터로 골라야 하고, 그 필터가 틀리면 남는다.
//       테이블이 다르면 지우는 경로도 다르다.

/// 자기 자신에 대한 기억 — 🔴 은퇴 후에도 이력으로 보존한다
model PersonaSelfMemory {
  id        String  @id @default(cuid())
  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  /// 🔴 사실 요약만. 생성물 원문을 넣지 않는다
  summary          String  @db.Text
  /// 어떤 발화에서 나온 기억인가 — PersonaActivityLog.id
  sourceActivityId String?

  createdAt DateTime @default(now())

  @@index([personaId, createdAt])
}

/// 회원과의 관계 기억.
/// 🔴 회원 탈퇴 시 즉시 삭제 대상이다. @@index([userId]) 가 그것을 가능하게 한다 —
///    복합 인덱스만 두면 userId 로만 지울 때 전체 스캔이 된다.
model PersonaUserRelationship {
  id        String  @id @default(cuid())
  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 🔴 회원이 공개한 범위만. 추론한 개인정보를 넣지 않는다
  knownFacts       Json?
  /// 마지막 상호작용 시각 — 보존 기간 판정에 쓴다
  lastInteractedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personaId, userId])
  @@index([userId])
  @@index([personaId, lastInteractedAt])
}

/// 커뮤니티 전반에 대한 기억 — 회원을 가리키지 않는다
model PersonaCommunityMemory {
  id        String  @id @default(cuid())
  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  topic   String
  summary String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personaId, topic])
}

/// 하지 말아야 할 것의 기억 — 실패에서 배운 것.
/// 🔴 보존한다. 지우면 같은 실수를 반복한다
model PersonaNegativeMemory {
  id        String  @id @default(cuid())
  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  /// 무엇을 하지 않아야 하는가 — 🔴 요약만
  avoidance  String  @db.Text
  /// 왜 — Gate 실패 코드 · 운영자 사유 코드
  reasonCode String?

  createdAt DateTime @default(now())

  @@index([personaId, createdAt])
}

// ── 로그 · 스위치 ──────────────────────────────────────────
//    🔴 AuditLog 와 ActivityLog 를 합치지 않는다. 주기가 100배 다르다.
//       합치면 "이 페르소나 정의가 언제 바뀌었나" 를 발화 수십만 건 속에서 찾아야 한다.

/// 페르소나 **정의**의 변경 이력. 드물게 쌓인다
model PersonaAuditLog {
  id        String  @id @default(cuid())
  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  action PersonaAuditAction

  /// 상태 전환일 때의 전/후
  fromStatus PersonaStatus?
  toStatus   PersonaStatus?

  /// 운영자 User.id. 🔴 자동 전환이면 null
  actorUserId   String?
  /// 사유 코드 또는 짧은 요약. 🔴 원문을 넣지 않는다
  reason        String?  @db.Text
  /// 수정 diff 요약 — 🔴 생성물 원문이 아니라 어떤 필드가 바뀌었는지
  changedFields String[] @default([])

  createdAt DateTime @default(now())

  @@index([personaId, createdAt])
  @@index([action, createdAt])
}

/// 페르소나의 **발화** 이력. 잦게 쌓인다.
/// 🔴 생성물 원문을 담지 않는다 — 발행된 것은 Post·Comment 에 있고,
///    폐기된 것은 남길 이유가 없다. 요약과 Gate 결과만 남긴다.
model PersonaActivityLog {
  id        String  @id @default(cuid())
  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  kind PersonaActivityKind

  /// 발행됐다면 그 Post.id 또는 Comment.id.
  /// 🔴 FK 를 걸지 않는다 — 폐기된 후보는 대상이 없고, kind 에 따라 테이블이 다르다
  targetId String?

  /// Gate 9관문 결과 — pass / review / regenerate / reject
  gateStatus String?
  /// 관문별 판정 요약. 🔴 원문 조각 없이 코드·개수만
  gateHits   Json?
  /// AI 티 태그 8종. 🔴 String[] 이다 — 관찰로 늘어나는데 그때마다 migration 은 과하다
  aiToneTags String[] @default([])

  /// auto | operator. 🔴 자동화 단계가 올라가면 auto 비율이 는다
  decidedBy   String?
  publishedAt DateTime?

  createdAt DateTime @default(now())

  @@index([personaId, createdAt])
  @@index([createdAt])
  @@index([kind, createdAt])
}

/// 🔴 전체 kill switch. 단일 행으로 운영한다.
///    페르소나 20개의 status 를 하나씩 바꾸는 것은 사고 상황에서 쓸 수 없다.
///    전략 §10-2: kill switch 가 없으면 자동화 2단계를 열 수 없다.
/// 승인 대기열의 상태.
///
/// 🔴 PENDING 으로 옮기는 것은 **사람 또는 Gate 통과 적재뿐**이다.
///    자동 발행 경로를 여기에 만들지 않는다 (MicroSeedCandidateStatus 와 같은 원칙).
enum PersonaCandidateStatus {
  PENDING    // 대기열. 사람이 읽고 결정한다
  APPROVED   // 승인 — 🔴 발행이 아니다. 발행 경로는 별도 승인 대상이다
  EDITED     // 수정 후 승인 — editedText · editDiff 가 함께 있어야 한다
  DECLINED   // 폐기 — 🔴 사유 코드 필수
  PUBLISHED  // 발행 완료. 🔴 비가역
  EXPIRED    // 기한 경과. 🔴 방치가 승인이 되지 않는다
}

/// 페르소나 댓글 후보 승인 대기열.
///
/// 정본: docs/operations/2026-08-30-persona-architecture-design.md §13
///
/// 🔴 **승인 대기열은 종착지가 아니라 계측 장치다**(Architecture §15).
///    무엇이 걸리고 무엇이 통과하는지 재서 자동화 조건을 찾는 곳이다.
///
/// 🔴 sourceTexts(원문 · 원댓글 전문)를 저장하지 않는다.
///    Gate ① 이 대조에 쓰지만, DB 에 남기면 외부 커뮤니티 원문이 우리 DB 에 쌓인다.
///    Architecture §13 이 "원문 링크는 운영자만" 이라 한 것에 맞춰 storyRefs 참조만 둔다.
model PersonaApprovalQueue {
  id String @id @default(cuid())

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Restrict)

  /// 어느 글에 달 댓글인가. 🔴 대상 선정(M3 반응 지도)이 아직 연결되지 않아 nullable 이다
  targetPostId String?

  status PersonaCandidateStatus @default(PENDING)

  /// 🔴 어드민 전용. 고객 경로에서 읽지 않는다
  candidateText String  @db.Text
  /// 수정 후 승인본
  editedText    String? @db.Text
  /// 🔴 무엇을 왜 고쳤나 — 개선 근거다. 수정 승인의 값어치는 여기에 있다
  editDiff      Json?

  reactionType String
  /// pass · review — 🔴 regenerate · reject 는 대기열에 넣지 않는다
  gateStatus   String
  /// 9관문 결과. 🔴 코드 · 개수만. 원문 조각을 담지 않는다
  gateResults  Json
  aiToneTags   String[] @default([])
  /// 재생성 횟수 (Architecture §13 대기열 화면 요건)
  regenCount   Int      @default(0)

  /// 🔴 원문 전문이 아니라 참조만
  storyRefs String[] @default([])
  topicTags String[] @default([])
  /// ⑧ seed 재사용 축의 식별자. 없으면 비운다
  seedRef   String?

  /// 🔴 중복 적재 방지. persona + 정규화 본문 해시
  dedupKey String @unique

  /// 🔴 자유 텍스트가 아니라 코드다. 집계되지 않으면 개선 근거가 되지 못한다
  declineReason String?
  decidedBy     String?
  decidedAt     DateTime?
  publishedCommentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([personaId, createdAt])
}

model PersonaGlobalSwitch {
  /// 🔴 항상 'global' 한 행이다
  id String @id @default("global")

  /// 🔴 kill switch 다. 이름이 enabled 라 반대로 읽히기 쉽다 —
  ///    "발화가 켜졌나" 가 아니라 "중지가 켜졌나" 를 뜻한다.
  ///      true  = 중지 켜짐 — 모든 페르소나 발화가 멈춘다
  ///      false = 중지 꺼짐 — 멈춰 있지 않다
  ///      행 없음 = false 와 같다 (기본 상태)
  ///    default false 인 이유: 만들자마자 전체가 멈추면 안 된다.
  enabled Boolean @default(false)

  /// 왜 중지했는가 / 왜 해제했는가 — 사유
  reason    String?
  changedBy String?
  changedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
