<?xml version="1.0" encoding="UTF-8"?>
<!--
  82cook 얇은 상세 수집 — 🔴 템플릿이다. 등록되어 있지 않다 (README.md 참조)

  정본: docs/operations/2026-09-03-raw-supply-chain-design.md §4-AP · §4-AU

  하는 일: 이미 받아 둔 82cook 목록에서 열 대상을 골라 **본문 앞 300자만** 남긴다.
           산출물은 .microseed-data/82cook-thin-<runId>.thin-detail.jsonl 하나다.

  🔴 왜 별도 job 인가 (2026-09-11)
     이 몫은 예전에 `supply-autopilot` 안의 **조건부 수집**이었다 — 재고가 모자랄 때만
     열렸고, 82cook 이 막히면 이미 받아 둔 네이버 수집물까지 처리되지 못했다.
     수집은 source 마다 독립 job 이어야 한다. 하나가 죽어도 나머지는 자기 스케줄로 돈다.

  🔴 이 job 은 전문을 남기지 않는다
     rawBody · body · sourceBody 컬럼이 산출물에 없다. Raw Vault 용 전문 수집은
     raw-collect-82cook 이 따로 한다 — 레인이 다르다.

  🔴 이 job 은 DB 를 만지지 않는다
     Prisma 를 import 하지 않는다. 적재는 supply-process 가 한다.

  🔴 하루 요청 상한을 raw 수집과 나눠 쓴다
     목록 33 × 5 = 165 + 얇은 상세 17 × 5 = 85 → **250 / 상한 400** (여유 150).
     🔴 한 회차 17건은 **고정값**이다. 일정이 바뀔 때마다 상한이 따라 커지면
     안전장치가 아니다 — 82cook 유입 관측이 쌓이기 전까지 보수적으로 둔다.
     숫자의 정본은 src/lib/collect-schedule.ts 의 THIN_82COOK_CAP_PER_RUN ·
     THIN_82COOK_SLOTS 이고, fixture 가 이 인자·시각과 대조한다.

  🔴 슬롯: 하루 5회 — 07:40 · 10:40 · 13:40 · 16:40 · 19:40 KST (2026-09-11 확정)
     raw-collect-82cook(매 :00) 의 **40분 뒤**다. 목록을 먼저 받아 둔 회차에서
     골라야 새 글이 잡힌다 — 같은 분에 두면 빈 목록을 보고 0건으로 끝난다.

  🔴 kill switch 는 plist 가 아니라 환경변수다
     .env.local 에 SORAN_82COOK_THIN_DETAIL_ENABLED=true 가 없으면 --live 는 무시된다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.soransoran.supply-collect-82cook-thin</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NPX__</string>
    <string>tsx</string>
    <string>__REPO__/scripts/micro-seed-82cook-thin-detail.mts</string>
    <string>--cap=17</string>
    <string>--live</string>
  </array>

  <!-- 🔴 launchd 기본 PATH 는 /usr/bin:/bin:/usr/sbin:/sbin 뿐이다. nvm 의 node 가 없다.
       npx 의 shebang 이 #!/usr/bin/env node 라 PATH 를 주지 않으면 프로세스가 뜨기도 전에
       exit 78 로 죽는다. 2026-09-07 첫 kickstart 에서 실측했다. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODEBIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>40</integer></dict>
  </array>

  <!-- 🔴 RunAtLoad 를 쓰지 않는다. load 하는 순간 남의 서버로 나가는 것은 의도가 아니다 -->
  <key>RunAtLoad</key>
  <false/>

  <!-- 🔴 로그를 ~/Documents 아래 두면 TCC 로 막혀 exit 78 이다. __LOGDIR__ 은 Documents 밖이다 -->
  <key>StandardOutPath</key>
  <string>__LOGDIR__/supply-collect-82cook-thin.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/supply-collect-82cook-thin-error.log</string>
</dict>
</plist>
