<?xml version="1.0" encoding="UTF-8"?>
<!--
  82cook Raw 수집 — 🔴 템플릿이다. 등록되어 있지 않다 (README.md 참조)

  정본: docs/operations/2026-09-03-raw-supply-chain-design.md §4 · §5
        docs/constitution/MICRO_SEED_LANE_CONSTITUTION.md §6-9-F (공급 cron 개방)

  🔴 이 job 은 DB 를 만지지 않는다
     collector 는 prisma 를 import 하지 않는다. 산출물은 로컬 JSONL 뿐이고
     Raw Vault 적재는 별도 job(raw-import)이 한다. 경계를 파일로 나눈 설계다.

  🔴 kill switch 는 plist 가 아니라 환경변수다
     .env.local 의 SORAN_82COOK_COLLECT_ENABLED=true 가 없으면 --live 는 무시된다.
     plist 를 지우지 않고 멈출 수 있어야 한다.

  🔴 상한은 인자에 박는다
     --auto-max=30 · 2초 고정 지연. 한 슬롯 약 1분 30초.

  🔴 슬롯: 하루 5회 — 07:00 · 10:00 · 13:00 · 16:00 · 19:00 KST (2026-09-11 확정)
     앞선 판은 2시간 간격 10회(07:10~01:10)였다. 01:10 처럼 **노트북이 꺼져 있는 시각**에
     슬롯을 두면 예약은 있는데 회차는 돌지 않는다. 사람이 켜 두는 시간 안으로 옮겼다.
     🔴 이 job 이 목록을 만든다 — supply-collect-82cook-thin 이 40분 뒤 그 목록을 소비한다.
     🔴 82cook 하루 요청: 목록 33×5 = 165 + 얇은 상세 17×5 = 85 → 250 / 상한 400
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.soransoran.raw-collect-82cook</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NPX__</string>
    <string>tsx</string>
    <string>__REPO__/scripts/micro-seed-collect-82cook.mts</string>
    <string>--list</string>
    <string>--pages=3</string>
    <string>--auto</string>
    <string>--auto-max=30</string>
    <string>--live</string>
  </array>

  <!-- 🔴 launchd 기본 PATH 는 /usr/bin:/bin:/usr/sbin:/sbin 뿐이다. nvm 의 node 가 없다.
       npx 의 shebang 이 #!/usr/bin/env node 라 PATH 를 주지 않으면 프로세스가 뜨기도 전에
       exit 78 로 죽는다 — stdout·stderr 어디에도 원인이 남지 않아 "등록은 됐는데 아무 일도
       안 일어나는" 상태가 된다. 2026-09-07 첫 공급 job kickstart 에서 실측했다. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODEBIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <!-- 🔴 RunAtLoad 를 쓰지 않는다. load 하는 순간 수집이 도는 것은 의도가 아니다 -->
  <key>RunAtLoad</key>
  <false/>

  <!-- 🔴 로그를 ~/Documents 아래 두면 launchd 가 그 파일을 열지 못해 역시 exit 78 이다.
       macOS 의 Documents 접근 보호(TCC) 때문이다. __LOGDIR__ 은 Documents 밖이어야 한다
       (기본 $HOME/Library/Logs/soransoran). ~ 나 $HOME 은 plist 안에서 확장되지 않으므로
       설치 스크립트가 **절대경로로 치환**한다. -->
  <key>StandardOutPath</key>
  <string>__LOGDIR__/raw-collect-82cook.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/raw-collect-82cook-error.log</string>
</dict>
</plist>
