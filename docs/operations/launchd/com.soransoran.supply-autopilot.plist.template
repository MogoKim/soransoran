<?xml version="1.0" encoding="UTF-8"?>
<!--
  공급 Autopilot v1 — 🔴 템플릿이다. 등록되어 있지 않다 (README.md 참조)

  정본: docs/operations/2026-09-03-raw-supply-chain-design.md §4-AU

  하는 일: 재고가 목표(14건) 미만일 때만
           82cook thin 수집 → 검수용 변환 → 자동 판정 → 초안 생성 → Queue 보충

  🔴 이 job 은 발행하지 않는다
     Post · persona 배정 · ActivityLog 를 만들지 않는다.
     발행은 auto-publish(GHA, 매일 00:05 KST)가 한다.

  🔴 시각을 21:10 KST 로 둔 이유
     auto-publish 가 00:05 KST 다. 공급이 발행보다 약 3시간 앞선다 —
     수집(최장 50건 × 3~5초 ≈ 4분) · 판정 · 생성 · 적재가 다 끝나고도
     사람이 로그를 볼 여유가 남는 간격이다.
     🔴 하루 한 번이다. 재고가 차 있으면 그 한 번도 네트워크로 나가지 않는다.

  🔴 kill switch 는 plist 가 아니라 환경변수다
     .env.local 에 아래 둘이 모두 true 여야 실제로 돈다.
       SORAN_SUPPLY_AUTOPILOT_ENABLED=true      (러너 전체)
       SORAN_82COOK_THIN_DETAIL_ENABLED=true    (수집 단계)
     하나라도 없으면 러너가 시작 전에 멈춘다 — 반쪽 상태를 남기지 않기 위해서다.
     plist 를 지우지 않고 멈출 수 있어야 한다.

  🔴 동시 실행은 러너가 막는다
     .microseed-data/supply-autopilot.lock — 90분 TTL · 죽은 프로세스면 즉시 회수.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.soransoran.supply-autopilot</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NPX__</string>
    <string>tsx</string>
    <string>__REPO__/scripts/supply-autopilot.mts</string>
    <string>--live</string>
  </array>

  <!-- 🔴 launchd 기본 PATH 는 /usr/bin:/bin:/usr/sbin:/sbin 뿐이다. nvm 의 node 가 없다.
       npx 의 shebang 이 #!/usr/bin/env node 라 PATH 를 주지 않으면 프로세스가 뜨기도 전에
       exit 78 로 죽는다 — stdout·stderr 어디에도 원인이 남지 않아 "등록은 됐는데 아무 일도
       안 일어나는" 상태가 된다. 2026-09-07 supply-autopilot 첫 kickstart 에서 실측했다. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODEBIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
  </array>

  <!-- 🔴 RunAtLoad 를 쓰지 않는다. load 하는 순간 밖으로 나가는 것은 의도가 아니다 -->
  <key>RunAtLoad</key>
  <false/>

  <!-- 🔴 로그를 ~/Documents 아래 두면 launchd 가 그 파일을 열지 못해 역시 exit 78 이다.
       macOS 의 Documents 접근 보호(TCC) 때문이다. __LOGDIR__ 은 Documents 밖이어야 한다
       (기본 $HOME/Library/Logs/soransoran). ~ 나 $HOME 은 plist 안에서 확장되지 않으므로
       설치 스크립트가 **절대경로로 치환**한다. -->
  <key>StandardOutPath</key>
  <string>__LOGDIR__/supply-autopilot.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/supply-autopilot-error.log</string>
</dict>
</plist>
