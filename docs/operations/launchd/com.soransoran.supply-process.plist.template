<?xml version="1.0" encoding="UTF-8"?>
<!--
  공급 처리(글 만들기) — 🔴 **이 파일은 생성된다. 손으로 고치지 않는다**
    만드는 곳  scripts/lib/supply-process-template.mts (npm run launchd:supply-template -- --write)
    회차 시각  src/lib/cycle-schedule.ts — 수집 바퀴(CYCLES 13회)마다 수집 시작 15분 뒤 한 번
               (01:15 04:15 06:45 08:35 10:15 11:35 12:35 13:35 15:35 17:35 18:35 20:35 22:35)
    회차 창    45분 — 이 시각들이 러너의 정기 회차 창과 같아야 유료 요청이 나간다

  하는 일: 디스크에 있는 미처리 수집 결과를 분류 → 판정 → 글쓴이 → 초안 → 검수 → 대기열까지 잇는다.
  🔴 수집하지 않는다 · 발행하지 않는다. 수집이 실패한 바퀴에도 뜬다 — 있는 입력만 처리하고, 없으면 정상 no-op 이다.
  🔴 kill switch 는 .env.local 의 SORAN_SUPPLY_PROCESS_ENABLED=true — plist 를 지우지 않고 멈춘다.
  🔴 동시 실행은 러너의 커널 lease 가 막는다(scripts/lib/supply-lease.mts) — 강제 종료 · 재부팅이면 커널이 푼다.
  🔴 launchd 기본 PATH 에는 nvm 의 node 가 없다(없으면 exit 78) · 로그는 Documents 밖(__LOGDIR__ · TCC).
  🔴 RunAtLoad 를 쓰지 않는다 — load 하는 순간 모델을 부르는 것은 의도가 아니다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.soransoran.supply-process</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NPX__</string>
    <string>tsx</string>
    <string>__REPO__/scripts/stage-consume-exec.mts</string>
    <string>--by=supply</string>
    <string>--</string>
    <string>__NPX__</string>
    <string>tsx</string>
    <string>__REPO__/scripts/supply-process.mts</string>
    <string>--live</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODEBIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>35</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__LOGDIR__/supply-process.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/supply-process-error.log</string>
</dict>
</plist>
