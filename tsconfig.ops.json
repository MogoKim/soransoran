{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "server-only": ["./scripts/lib/server-only-shim.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.mts"],
  "exclude": ["node_modules"]
}
